[Desktop Entry]
Type=Application
Name=Studio Inspirasi
Comment=Edit video and audio locally
Exec=studio-inspirasi
Icon=studio-inspirasi
Categories=AudioVideo;Video;
Terminal=false
StartupWMClass=io.github.hams-rmdhn.studio-inspirasi
Actions=SafeGraphics;

[Desktop Action SafeGraphics]
Name=Safe graphics
Exec=studio-inspirasi --software
